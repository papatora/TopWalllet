# ============================================================
# TopWallet configuration template — CHAIN: Robinhood Chain (4663)
# Copy to .env and fill in values. NEVER commit your real .env.
# The pipeline runs with ZERO paid keys (DexScreener + Blockscout +
# public RPC), but the Alchemy key unlocks fast log-based pricing.
# ============================================================

# --- Chain ---
CHAIN=robinhood
CHAIN_ID=4663

# --- Database ---
# Local MVP default (created automatically):
DATABASE_URL=sqlite+aiosqlite:///data/topwallet.db
# Postgres (docker-compose) example:
# DATABASE_URL=postgresql+asyncpg://topwallet:topwallet@postgres:5432/topwallet

# --- EVM JSON-RPC endpoints (comma-separated, rotating failover) ---
# Alchemy robinhood-mainnet keys give the best getLogs throughput.
EVM_RPC_ENDPOINTS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-mainnet.public.blastapi.io
RPC_RPS=4.0

# --- Blockscout explorer API (free; holders + transfers + history) ---
BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com
BLOCKSCOUT_RPS=8.0

# --- Key contracts on Robinhood Chain (public info, overridable) ---
UNISWAP_V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# --- DexScreener (free, no key) ---
DEXSCREENER_SEARCH_RPM=240
DEXSCREENER_PROFILES_RPM=55
DISCOVERY_QUERIES=USDG,ETH,WETH,robinhood
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_24H_USD=3000
MAX_TOKENS=200
MAX_WALLETS=20000
HOLDERS_PER_TOKEN=25
TRADER_PAGES_PER_TOKEN=2

# --- Enrichment ---
ENRICH_CONCURRENCY=3
ENRICH_MAX_PAGES_PER_WALLET=6
ENRICH_LIMIT_PER_RUN=0        # 0 = no cap (enrich all pending wallets)
LOOKBACK_DAYS=70              # auto-clamped to chain age (~2 months)
PRICE_LOOKBACK_DAYS=70        # depth of the per-pool price series
GETLOGS_START_WINDOW=2000000    # blocks per eth_getLogs call (adaptive halving)
PRICE_MAX_LOGS_PER_POOL=60000
DIP_WINDOW_DAYS=7

# --- Analysis thresholds ---
MIN_POSITIONS=5
MIN_DISTINCT_TOKENS=3
DIP_PERCENTILE=0.2
TOP_PERCENTILE=0.8
UNREALIZED_BIG_MULTIPLE=5.0

# --- Optional: HTTP proxies file (one per line: http://user:pass@host:port) ---
PROXY_URLS_FILE=

# --- Optional: alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Optional: auto-push results to GitHub after each run ---
GITHUB_REPO=papatora/TopWalllet
GITHUB_TOKEN=
GITHUB_BRANCH=main
AUTO_PUSH_RESULTS=true

# --- Scheduler (full pipeline re-run; cron in UTC) ---
PIPELINE_CRON=0 3 * * 0

# --- Real-time monitor ---
MONITOR_INTERVAL_SECONDS=30
ENABLE_MONITOR=false
TOP_WALLETS_FOR_MONITOR=100

# --- Experimental sources (off by default) ---
ENABLE_GMGN=false

# --- getLogs indexer lag safety (blocks) ---
SAFE_LOG_LAG_BLOCKS=150000

# --- ZAI watchdog (GLM flash via coding plan) ---
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3-flash
ZAI_API_KEY=

# --- Execution environment (SECURITY_POLICY.md) ---
# "vps" = heavy pipeline allowed. Local machines must NOT set this.
TOPWALLET_RUN_ENV=
# FORCE_LOCAL=true only if the USER explicitly accepts running heavy jobs locally
